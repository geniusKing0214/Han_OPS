rules_version = '2';
// Firestore 콘솔 → 빌드 → Firestore Database → 규칙(Rules) 에 이 내용을 붙여넣고 게시(Publish) 하세요.
// 첫 관리자 만들기: 회원가입 후 콘솔 → Firestore → 컬렉션 `users` → 본인 uid 문서에서 `role` 을 `admin` 으로 수정.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && callerDoc().data.role == "admin";
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // 본인 최초 생성: 일반 사용자만 생성 가능 (관리자 승격은 기존 관리자 또는 콘솔에서 처리)
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "member"
        && request.resource.data.accountStatus == "pending"
        && request.resource.data.email is string
        && request.resource.data.keys().hasOnly([
          "email",
          "role",
          "accountStatus",
          "displayName",
          "createdAt",
          "team_id",
          "total_points"
        ])
        && (!("total_points" in request.resource.data)
          || request.resource.data.total_points == 0);

      // 관리자: 모든 필드 수정 가능 / 일반: role/accountStatus 변경 불가
      allow update: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == userId
        && (
          (
            request.resource.data.role == resource.data.role
            && request.resource.data.accountStatus == resource.data.accountStatus
          )
          ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens'])
        )
      );

      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      // 일반 회원: 본인 승인 신청 취소 시 정원(applied_count)만 되돌릴 수 있도록 허용.
      // positions/sessions 배열 크기(포지션·슬롯 구조)는 바뀔 수 없고, applied_count 외 다른 필드는 건드릴 수 없다.
      allow update: if isSignedIn() && !isAdmin() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['positions', 'updatedAt'])
          && request.resource.data.positions.size() == resource.data.positions.size()
        )
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sessions', 'updatedAt'])
          && request.resource.data.sessions.size() == resource.data.sessions.size()
        )
      );
    }

    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 한대나무숲 — 익명 건의사항. 제목만 이 문서에 저장되고 전 사용자에게 공개된다.
    // 본문은 detail/content 서브문서에 분리 저장해 관리자만 읽을 수 있게 한다.
    match /bambooForest/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.keys().hasOnly(['title', 'created_at']);
      allow update: if false;
      allow delete: if isAdmin();

      match /detail/{docId} {
        allow read: if isAdmin();
        allow create: if isSignedIn()
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 5000
          && request.resource.data.keys().hasOnly(['content']);
        // 관리자 답변만 수정 허용 — 원본 content는 절대 변경할 수 없다.
        allow update: if isAdmin()
          && request.resource.data.content == resource.data.content
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'answered_at'])
          && request.resource.data.answer is string
          && request.resource.data.answer.size() > 0
          && request.resource.data.answer.size() <= 5000;
        allow delete: if isAdmin();
      }
    }

    match /config/admins {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.targetUserId == request.auth.uid;

      allow create: if isSignedIn() && (
        (
          request.resource.data.type == 'application_submitted'
          && request.resource.data.createdByUserId == request.auth.uid
          && request.resource.data.targetRole == 'admin'
          && request.resource.data.targetUserId is string
        )
        ||
        (
          request.resource.data.type == 'application_cancelled'
          && request.resource.data.createdByUserId == request.auth.uid
          && request.resource.data.targetRole == 'admin'
          && request.resource.data.targetUserId is string
        )
        ||
        (
          isAdmin()
          && request.resource.data.type == 'schedule_created'
          && request.resource.data.targetRole == 'member'
          && request.resource.data.targetUserId is string
          && request.resource.data.createdByUserId == request.auth.uid
        )
        ||
        (
          isAdmin()
          && request.resource.data.type == 'schedule_cancelled'
          && request.resource.data.targetRole == 'member'
          && request.resource.data.targetUserId is string
          && request.resource.data.createdByUserId == request.auth.uid
        )
        ||
        (
          isAdmin()
          && request.resource.data.type == 'application_approved'
          && request.resource.data.targetRole == 'member'
          && request.resource.data.targetUserId is string
          && request.resource.data.createdByUserId == request.auth.uid
        )
        ||
        (
          isAdmin()
          && request.resource.data.type == 'notice_posted'
          && request.resource.data.targetUserId is string
          && request.resource.data.createdByUserId == request.auth.uid
        )
        ||
        (
          isAdmin()
          && (request.resource.data.type == 'workforce_confirmed'
            || request.resource.data.type == 'workforce_updated'
            || request.resource.data.type == 'workforce_cancelled')
          && request.resource.data.targetRole == 'member'
          && request.resource.data.targetUserId is string
          && request.resource.data.createdByUserId == request.auth.uid
        )
      );

      allow update: if isSignedIn()
        && resource.data.targetUserId == request.auth.uid
        && request.resource.data.targetUserId == resource.data.targetUserId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead', 'readAt']);

      allow delete: if isSignedIn()
        && resource.data.targetUserId == request.auth.uid;
    }

    match /applications/{appId} {
      function callerTeamId() {
        return callerDoc().data.get('team_id', 'team_1');
      }

      function canReadTeamApprovedApplication() {
        return isSignedIn()
          && !isAdmin()
          && resource.data.team_id == callerTeamId()
          && (resource.data.status == 'approved' || resource.data.status == 'completed');
      }

      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
        || canReadTeamApprovedApplication()
      );

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.applicantDisplayName is string
        && request.resource.data.applicantEmail is string
        && request.resource.data.status == "pending"
        && request.resource.data.work_status == "not_checked"
        && request.resource.data.points_awarded == false
        && request.resource.data.eventTitle is string
        && request.resource.data.venue is string
        && request.resource.data.date is string
        && request.resource.data.slotTime is string
        && request.resource.data.eventId is string
        && request.resource.data.sessionId is string
        && request.resource.data.slotId is string
        && request.resource.data.note is string
        && request.resource.data.team_id is string
        && request.resource.data.team_id in ['team_1', 'team_2'];

      // 일반 회원: 본인의 승인된 신청에 취소 요청만 걸 수 있다 (cancelRequestedAt 필드만 추가 가능).
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'approved'
        && !('cancelRequestedAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelRequestedAt'])
        && request.resource.data.cancelRequestedAt != null
      );
      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
    }

    match /point_logs/{logId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /monthlySheets/{sheetId} {
      function callerTeamId() {
        return callerDoc().data.get('team_id', 'team_1');
      }

      allow read: if isSignedIn() && (
        isAdmin() || resource.data.teamId == callerTeamId()
      );

      allow create, update, delete: if isAdmin();
    }

    // 인력 배정 스케줄러 (기존 events/applications 와 분리)
    match /workforceWeeks/{weekId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /workforceSchedules/{scheduleId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.status == 'confirmed'
      );
      allow create, update, delete: if isAdmin();
    }

    match /workforceAvailability/{userId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow create, update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && request.resource.data.userId == userId);
      allow delete: if isAdmin();
    }

    // 미신청자 목록 카운트 제외 인원 (주 단위, 관리자 공용)
    match /workforceAvailabilityExclusions/{weekId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /workforceLogs/{logId} {
      allow read, update, delete: if isAdmin();

      // 본인 근무 가능일 신청 기록은 본인이 직접 남길 수 있다 (감사 로그용).
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.action == 'member_submit_availability'
        && request.resource.data.actorUserId == request.auth.uid
        && request.resource.data.targetUserId == request.auth.uid
      );
    }

    // 관리자 승인/거절/취소 처리, 스케줄 등록/삭제 감사 로그 — 관리자 전용.
    match /activityLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /workforceMonthlyExports/{exportId} {
      allow read, create, update, delete: if isAdmin();
    }

    // 교육 신청 — 아무 승인 회원이나 개설·신청 가능. 마감은 개설자/관리자만.
    match /trainings/{trainingId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.location is string
        && request.resource.data.startAt is string
        && request.resource.data.content is string
        && request.resource.data.capacity is int
        && request.resource.data.capacity > 0
        && request.resource.data.status == 'open'
        && request.resource.data.applicants.size() == 0;

      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.createdBy == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['applicants', 'status', 'closeReason', 'updatedAt'])
      );

      allow delete: if isAdmin() || resource.data.createdBy == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
