# -----------------------------------------------------------------------------
# HAN OPS — Firebase (웹 앱) 환경 변수 양식
# -----------------------------------------------------------------------------
#
# 사용법:
#   1) Firebase Console → 프로젝트 설정 → 일반에서 웹 앱 구성 값을 복사합니다.
#   2) 이 파일을 참고해 루트에 `.env.local` 파일을 만들고 값을 채웁니다.
#   3) `npm run dev` 또는 배포 플랫폼(Environment Variables)에 동일 이름으로 등록합니다.
#
# 중요:
#   - `.env.local`은 gitignore 되므로 저장소에는 올라가지 않습니다.
#   - 아래 예시에는 실제 키를 넣지 마세요. (예시 문자열만 유지하거나 본인 값으로 교체)
#
# -----------------------------------------------------------------------------
#
# Firestore: `firestore.rules` 를 콘솔 Rules에 게시
# 최초 관리자: Firestore → users/{본인 UID} → role 을 admin
#
# -----------------------------------------------------------------------------
#
NEXT_PUBLIC_FIREBASE_API_KEY=여기에_apiKey
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=프로젝트.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=프로젝트_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=프로젝트.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=숫자
NEXT_PUBLIC_FIREBASE_APP_ID=1:숫자:web:xxxxxxxx
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-xxxx

# GitHub Pages 등 서브경로 배포 (레포 이름 Han_OPS → /Han_OPS)
# NEXT_PUBLIC_BASE_PATH=/Han_OPS

# 웹 푸시 / PWA (Firebase Console → Cloud Messaging → Web Push certificates)
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=BNxxxxxxxx...

# 백그라운드 푸시 릴레이 (Cloudflare Worker — Blaze 불필요)
# workers/push-relay 배포 후 Worker URL
# NEXT_PUBLIC_PUSH_RELAY_URL=https://han-ops-push-relay.xxxxx.workers.dev
# NEXT_PUBLIC_PUSH_API_SECRET=임의의_긴_비밀문자열

# Safari / GitHub Pages 로그인 (선택, 권장)
# Firebase Console → Authentication → Google → Web SDK 구성 의 Web client ID
# Google Cloud Console → OAuth 2.0 클라이언트 → 승인된 JavaScript 원본에 앱 URL 추가
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
